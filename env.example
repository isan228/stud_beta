PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stud_kg
DB_USER=postgres
DB_PASSWORD=your_password
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Finik Payments Configuration
FINIK_ENV=prod
FINIK_API_KEY=your_api_key_from_finik
# Отдельный ключ для Flutter Finik SDK (если не задан — используется FINIK_API_KEY)
FINIK_MOBILE_API_KEY=your_mobile_sdk_api_key
# FINIK_MOBILE_ACCOUNT_ID=your_mobile_account_id
# Приватный ключ можно указать здесь ИЛИ создать файл finik_private.pem в корне проекта
# FINIK_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----
FINIK_ACCOUNT_ID=your_account_id
FINIK_MERCHANT_CATEGORY_CODE=0742
FINIK_NAME_EN=stud.kg Payment
FINIK_WEBHOOK_URL=https://your-domain.com/api/payments/webhook
FINIK_REDIRECT_URL=https://your-domain.com/payment/success

# Корпоративная почта (вкладка «Почта» в админке)
MAIL_HOST=mail.stud.kg
MAIL_IMAP_PORT=993
MAIL_SMTP_PORT=587
MAIL_DOMAIN=stud.kg
MAIL_FROM_NAME=stud.kg
MAIL_ACCOUNTS=support,info,dev,noreply
MAIL_PASS_SUPPORT=пароль_support
MAIL_PASS_INFO=пароль_info
MAIL_PASS_DEV=пароль_dev
MAIL_PASS_NOREPLY=пароль_noreply
# Необязательно: своё имя отправителя для ящика
# MAIL_FROM_NAME_SUPPORT=stud.kg Поддержка

